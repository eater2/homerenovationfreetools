^https://www\.facebook\.com/
^https://www\.instagram\.com/

# Bot protection with a cookie redirect loop (works in a browser)
^https://wyszukiwarka-krs\.ms\.gov\.pl/

# Server sends the wrong intermediate TLS certificate; browsers fetch the right one, lychee cannot
^https://czystepowietrze\.gov\.pl/

# Drops connections from datacenter IPs (GitHub runners time out); fine from a browser
^https://www\.blocklayer\.com/
